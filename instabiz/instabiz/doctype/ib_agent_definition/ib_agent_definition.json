   "label": "System Prompt",
   "depends_on": "eval:doc.llm_enabled"
  },
  {
   "fieldname": "col_break_ai",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "llm_user_template",
   "fieldtype": "Small Text",
   "label": "User Prompt Template",
   "description": "Jinja2. Row fields available as vars.",
   "depends_on": "eval:doc.llm_enabled"
  },
  {
   "fieldname": "section_permissions",
   "fieldtype": "Section Break",
   "label": "Permissions"
  },
  {
