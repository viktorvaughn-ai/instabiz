 "fields": [
  {
   "fieldname": "agent_code",
   "fieldtype": "Data",
   "label": "Agent Code",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "description": "Unique code, no spaces (e.g. my_custom_alert). Used as agent identifier in IB AI Action."
  },
  {
   "fieldname": "agent_name",
   "fieldtype": "Data",
   "label": "Agent Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "module",
   "fieldtype": "Select",
   "label": "Module",
   "reqd": 1,
   "options": "\nSales\nHR\nFinance\nProduction\nProcurement\nOperations\nCustom",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "icon",
   "fieldtype": "Data",
   "label": "Icon",
   "description": "Lucide icon name, e.g. lucide:bell. Browse at lucide.dev.",
   "default": "lucide:bot"
  },
  {
   "fieldname": "color",
   "fieldtype": "Color",
   "label": "Accent Color",
   "default": "#888888"
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "section_trigger",
   "fieldtype": "Section Break",
   "label": "Schedule"
  },
  {
   "fieldname": "schedule_type",
   "fieldtype": "Select",
   "label": "Schedule Type",
   "options": "daily\nhourly\nmanual",
   "default": "daily",
   "reqd": 1
  },
  {
   "fieldname": "section_query",
   "fieldtype": "Section Break",
   "label": "Data Query"
  },
  {
   "fieldname": "data_query",
   "fieldtype": "Code",
   "label": "SQL Query",
   "options": "SQL",
   "description": "SELECT returning rows. Each row becomes one candidate AI Action. Available params: %(today)s"
  },
  {
   "fieldname": "dedup_key_field",
   "fieldtype": "Data",
   "label": "Dedup Key Field",
   "description": "Field name in query result to use as reference_name for dedup (e.g. 'name', 'invoice'). One pending action per key per day."
  },
  {
   "fieldname": "max_per_run",
   "fieldtype": "Int",
   "label": "Max per Run",
   "default": 20
  },
  {
   "fieldname": "col_break_q",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Reference Doctype",
   "options": "DocType",
   "description": "Doctype shown in reference_doctype on IB AI Action (enables link in inbox)"
  },
  {
   "fieldname": "reference_name_field",
   "fieldtype": "Data",
   "label": "Reference Name Field",
   "description": "Field in query result for reference_name. Falls back to dedup_key_field if blank."
  },
  {
   "fieldname": "section_output",
   "fieldtype": "Section Break",
   "label": "Action Output"
  },
  {
   "fieldname": "title_template",
   "fieldtype": "Data",
   "label": "Title Template",
   "reqd": 1,
   "description": "Jinja2. Row fields as vars. e.g. Overdue PO: {{po_name}} ({{days_overdue}}d)"
  },
  {
   "fieldname": "summary_template",
   "fieldtype": "Small Text",
   "label": "Summary Template",
   "description": "Jinja2. If blank, title is used."
  },
  {
   "fieldname": "action_type",
   "fieldtype": "Select",
   "label": "Action Type",
   "reqd": 1,
   "options": "acknowledge\nsend_notification\ncreate_doc\nupdate_doc\nsubmit_doc\nrun_function",
   "default": "acknowledge",
   "in_list_view": 1
  },
  {
   "fieldname": "action_config",
   "fieldtype": "Code",
   "label": "Action Config (JSON)",
   "options": "JSON",
   "description": "send_notification: {\"for_role\":\"HR Manager\",\"subject_template\":\"...\",\"message_field\":\"msg\"}\ncreate_doc: {\"doctype\":\"...\",\"field_map\":{\"target\":\"source\"}}\nupdate_doc: {\"field\":\"status\",\"value\":\"Done\"}\nrun_function: {\"function\":\"instabiz.overrides.xxx.fn\"}"
  },
  {
   "fieldname": "section_ai",
   "fieldtype": "Section Break",
   "label": "AI (Optional)"
  },
  {
   "fieldname": "llm_enabled",
   "fieldtype": "Check",
   "label": "Use Claude LLM",
   "default": 0
  },
  {
   "fieldname": "llm_system_prompt",
